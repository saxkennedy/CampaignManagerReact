<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
		<TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
		<IsPackable>false</IsPackable>
		<SpaRoot>App\</SpaRoot>
	</PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
  	<Content Remove="$(SpaRoot)**" />
  	<None Remove="$(SpaRoot)**" />
  	<None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="App\package.json" />
    <Content Include="App\staticwebapp.config.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CampaignManager.Data\CampaignManager.Data.csproj" />
    <ProjectReference Include="..\CampaignManager.Service\CampaignManager.Services.csproj" />
  </ItemGroup>

</Project>
